{
  "name": "siyuan-plugins-ai-cli-bridge",
  "version": "0.2.1",
  "type": "module",
  "description": "DeepSeek Harness chat and optional Web panel inside SiYuan",
  "repository": {
    "type": "git",
    "url": "https://github.com/yangtaihong59/siyuan-plugins-ai-cli-bridge.git"
  },
  "homepage": "https://github.com/yangtaihong59/siyuan-plugins-ai-cli-bridge",
  "author": "Taihong Yang",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "build": "cross-env NODE_ENV=production vite build && node scripts/verify-bundle.mjs && node scripts/package.mjs",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "make-install": "pnpm build && node --no-warnings ./scripts/make_install.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview:ui": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "test:notebooks": "node scripts/run-live-notebook-read.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tsconfig/svelte": "^4.0.1",
    "@types/node": "^20.3.0",
    "cross-env": "^7.0.3",
    "fast-glob": "^3.2.12",
    "glob": "^10.0.0",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.1.7",
    "svelte": "^4.2.20",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "vite": "^5.2.9",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@10.29.3"
}
